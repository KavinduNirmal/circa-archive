{
  "name": "circa-repository-tooling",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "husky",
    "test": "bun test ./tests",
    "check": "bun run scripts/check-repository.ts",
    "check:staged": "bun run scripts/check-repository.ts --staged",
    "check:client": "bun run --cwd=client lint && bun run --cwd=client typecheck && bun run --cwd=client test",
    "precommit": "bun run format:staged && bun run check:staged && bun run test && bun run check:client",
    "format:staged": "lint-staged --config package.json",
    "format": "bun run scripts/format.ts",
    "format:check": "bun run scripts/format.ts --check"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  },
  "lint-staged": {
    "*": "bunx --no-install prettier --write --ignore-unknown"
  }
}
