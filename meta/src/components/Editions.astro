---
import { t, archiveHref, type Locale } from "../lib/site";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="edition-pair">
  <article class="edition">
    <span class="edition-index">{t(locale, "readingIndex")}</span>
    <h3>{t(locale, "readingTitle")}</h3>
    <p>{t(locale, "readingBody")}</p>
    <div class="edition-foot">
      <a class="text-link" href={archiveHref(locale)}>
        {t(locale, "readingLink")} <span aria-hidden="true">↗</span>
      </a>
      <span class="edition-note">{t(locale, "readingNote")}</span>
    </div>
  </article>
  <article class="edition">
    <span class="edition-index">{t(locale, "workstationIndex")}</span>
    <h3>{t(locale, "workstationTitle")}</h3>
    <p>{t(locale, "workstationBody")}</p>
    <div class="edition-foot">
      <a class="text-link" href={archiveHref(locale, "/desktop")}>
        {t(locale, "workstationLink")} <span aria-hidden="true">↗</span>
      </a>
      <span class="edition-note">{t(locale, "workstationNote")}</span>
    </div>
  </article>
</div>
