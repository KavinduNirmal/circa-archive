---
import { t, archiveHref, type Locale } from "../lib/site";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<figure class="specimen">
  <div class="specimen-head">
    <span class="specimen-code">{t(locale, "specimenCode")}</span>
    <span>{t(locale, "specimenMeta")}</span>
    <span class="specimen-seal" aria-hidden="true"></span>
  </div>
  <p class="specimen-title">{t(locale, "specimenTitle")}</p>
  <p class="specimen-text">{t(locale, "specimenText")}</p>
  <a href={archiveHref(locale, `/site/records/${t(locale, "specimenCode")}`)}>
    {t(locale, "specimenLink")} <span aria-hidden="true">↗</span>
  </a>
  <figcaption>{t(locale, "specimenNote")}</figcaption>
</figure>
