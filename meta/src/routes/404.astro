---
import Shell from "../layouts/Shell.astro";
import { t, projectHref } from "../lib/site";
---

<Shell
  locale="en"
  title={t("en", "notFoundTitle")}
  description={t("en", "notFoundBody")}
  noindex
>
  <article class="essay">
    <header class="opening page-opening error-page">
      <h1>{t("en", "notFoundTitle")}</h1>
      <p class="opening-lead">{t("en", "notFoundBody")}</p>
      <div class="action-row">
        <a class="button primary" href={projectHref("en", "documentation")}>
          {t("en", "navDocs")} <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={projectHref("ko")}>
          한국어 ↗
        </a>
      </div>
    </header>
  </article>
</Shell>
