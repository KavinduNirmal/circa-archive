---
import Shell from "../../layouts/Shell.astro";
import Specimen from "../../components/Specimen.astro";
import Editions from "../../components/Editions.astro";
import Faq from "../../components/Faq.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import Beginnings from "../../components/Beginnings.astro";
import {
  locales,
  t,
  projectHref,
  archiveHref,
  LICENCES,
  REPOSITORY,
  type Locale,
} from "../../lib/site";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const facts = ["Website", "Archive", "Source", "Checks"];
const badges = [
  { label: "MIT", href: LICENCES.code, name: "MIT licence" },
  {
    label: "CC BY-NC-SA 4.0",
    href: LICENCES.content,
    name: "CC BY-NC-SA 4.0 licence",
  },
  { label: "Astro" },
  { label: "Next.js" },
  { label: "React" },
  { label: "Markdown" },
  { label: ".NET" },
  { label: "PostgreSQL" },
  { label: "Docker" },
];
---

<Shell
  locale={locale}
  title={t(locale, "brand")}
  description={t(locale, "homeLede")}
>
  <article class="essay">
    <header
      class="opening landing-opening"
      data-section="hero"
      aria-labelledby="home-title"
    >
      <p class="opening-aside">{t(locale, "homeHeroAside")}</p>
      <h1 id="home-title">
        {t(locale, "heroTitleA")}
        <span>{t(locale, "heroTitleB")}</span>
      </h1>
      <p class="opening-lead">{t(locale, "homeOpeningLead")}</p>
      <div class="opening-actions">
        <a href={projectHref(locale, "documentation")}>
          {t(locale, "heroPrimary")} <span aria-hidden="true">→</span>
        </a>
        <a href={archiveHref(locale)}>
          {t(locale, "heroSecondary")} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="opening-note">{t(locale, "heroNote")}</p>
    </header>

    <div class="essay-body">
      <aside class="margin-note">
        <span class="note-code">
          CIRCA / {t(locale, "institutionLabelShort")}
        </span>
        <p>
          <strong>{t(locale, "agencyName")}</strong>
        </p>
        <p>{t(locale, "agencyMotto")}</p>
        <div class="note-rule"></div>
        <p>{t(locale, "homeKicker")}</p>
      </aside>

      <div class="essay-flow">
        <section
          class="passage"
          data-section="premise"
          aria-labelledby="premise-title"
        >
          <h2 id="premise-title">{t(locale, "introductionTitle")}</h2>
          <p>{t(locale, "introductionBody")}</p>
          <p>{t(locale, "introductionSecond")}</p>
          <p>{t(locale, "introductionThird")}</p>
          <div class="passage-links">
            <a href={projectHref(locale, "about/project")}>
              {t(locale, "navProject")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section
          class="passage"
          data-section="witnessing"
          aria-labelledby="witnessing-title"
        >
          <h2 id="witnessing-title">{t(locale, "witnessingTitle")}</h2>
          <p>{t(locale, "witnessingBody")}</p>
          <p>{t(locale, "witnessingSecond")}</p>
          <div class="passage-links">
            <a href={projectHref(locale, "documentation/lore-records")}>
              {t(locale, "witnessingRecordsLink")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
            <a href={projectHref(locale, "documentation/lore-circa")}>
              {t(locale, "witnessingCircaLink")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <blockquote class="quote">
          {t(locale, "quote")}
          <cite>{t(locale, "quoteAttribution")}</cite>
        </blockquote>

        <section
          class="passage"
          data-section="fiction"
          aria-labelledby="fiction-title"
        >
          <h2 id="fiction-title">{t(locale, "fictionTitle")}</h2>
          <p>{t(locale, "fictionBody")}</p>
          <p>{t(locale, "fictionSecond")}</p>
          <p>{t(locale, "fictionThird")}</p>
          <figure class="fiction-plate">
            <img
              src="/library.jpg"
              alt={t(locale, "fictionImageAlt")}
              width="1200"
              height="673"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>Fig. 01</span>
              {t(locale, "fictionImageCaption")}
            </figcaption>
          </figure>
          <div class="passage-links">
            <a href={projectHref(locale, "about/project")}>
              {t(locale, "navProject")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section
          class="passage"
          data-section="editions"
          aria-labelledby="welcome-title"
        >
          <h2 id="welcome-title">{t(locale, "welcomeTitle")}</h2>
          <p>{t(locale, "welcomeBody")}</p>
          <p>{t(locale, "welcomeSecond")}</p>
          <Specimen locale={locale} />
          <p class="pair-label">{t(locale, "editionsKicker")}</p>
          <Editions locale={locale} />
        </section>

        <section
          class="passage"
          data-section="documentation"
          aria-labelledby="chapters-title"
        >
          <h2 id="chapters-title">{t(locale, "homeIndex")}</h2>
          <p>{t(locale, "homeIndexLede")}</p>
          <Beginnings locale={locale} />
        </section>

        <section
          class="passage"
          data-section="building"
          aria-labelledby="building-title"
        >
          <h2 id="building-title">{t(locale, "builtTitle")}</h2>
          <p class="build-lede">{t(locale, "buildLede")}</p>
          <p class="build-stack">
            <span class="sr-only">{t(locale, "buildBadgesLabel")}: </span>
            {badges.map((badge, index) => (
              <Fragment>
                {index > 0 && (
                  <span class="stack-sep" aria-hidden="true">
                    ·
                  </span>
                )}
                {badge.href ? (
                  <a href={badge.href} aria-label={badge.name}>
                    {badge.label}
                  </a>
                ) : (
                  <span class="build-term">{badge.label}</span>
                )}
              </Fragment>
            ))}
          </p>
          <dl class="fact-list build-facts">
            {facts.map((key) => (
              <div>
                <dt>{t(locale, `fact${key}`)}</dt>
                <dd>{t(locale, `fact${key}Body`)}</dd>
              </div>
            ))}
          </dl>
          <div class="passage-links">
            <a href={projectHref(locale, "documentation/building")}>
              {t(locale, "chapterBuilding")} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section
          class="passage"
          data-section="contribution"
          aria-labelledby="contribution-title"
        >
          <h2 id="contribution-title">{t(locale, "contributeTitle")}</h2>
          <p>{t(locale, "contributeLede")}</p>
          <div class="passage-links">
            <a href={projectHref(locale, "documentation/contribution")}>
              {t(locale, "contributorsLink")} <span aria-hidden="true">↗</span>
            </a>
            <a href={REPOSITORY} target="_blank" rel="noreferrer">
              <BrandIcon name="github" /> {t(locale, "contributeRepository")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>

        <section
          class="passage"
          data-section="questions"
          aria-labelledby="faq-title"
        >
          <h2 id="faq-title">{t(locale, "faqTitle")}</h2>
          <p>{t(locale, "faqLede")}</p>
          <Faq locale={locale} />
        </section>

        <section
          class="passage"
          data-section="closing"
          aria-labelledby="closing-title"
        >
          <h2 id="closing-title">{t(locale, "homeClosing")}</h2>
          <p>{t(locale, "homeClosingLede")}</p>
          <div class="action-row">
            <a
              class="text-link"
              href={projectHref(locale, "documentation/contribution")}
            >
              {t(locale, "chapterContribution")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={projectHref(locale, "sponsor")}>
              {t(locale, "navSponsor")} <span aria-hidden="true">↗</span>
            </a>
            <a
              class="text-link"
              href={REPOSITORY}
              target="_blank"
              rel="noreferrer"
            >
              <BrandIcon name="github" /> {t(locale, "footerSource")}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </article>
</Shell>
