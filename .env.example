# CIRCA Archive environment template.
#
# Copy this file to .env at the repository root for Docker Compose. Next.js
# overrides belong in client/.env.local. Keep real values out of Git.
# Public fixture browsing and repository tooling need no secrets.
# Production authentication requires API_ORIGIN and the backend settings below.
#
# Optional public-project links used by the project pages. Leave these unset to
# use the defaults in client/src/components/meta/meta-links.ts.
# PROJECT_REPOSITORY_URL=https://github.com/your-account/circa-archive
# PROJECT_SPONSOR_URL=https://github.com/sponsors/your-account
# PROJECT_CONTACT_URL=https://github.com/your-account/circa-archive/issues/new

# Documentation Git ref (defaults to develop). Set in the client environment.
# PROJECT_DOCUMENTATION_REF=develop

# Backend auth: supply through user-secrets in development or environment in production.
# Auth__SigningKey=
# Auth__Issuer=
# Auth__Audience=
# AllowedOrigins__0=http://localhost:3001

# Next.js server-only API origin (development defaults to http://localhost:5040).
# API_ORIGIN=

# Optional client build setting for constrained development machines.
# CIRCA_LOW_RESOURCE=1

# Local Docker Compose: set both values to random strings before starting.
# Generate each with: openssl rand -hex 32
CIRCA_AUTH_SIGNING_KEY=
CIRCA_POSTGRES_PASSWORD=
CIRCA_CLIENT_PORT=3001
CIRCA_API_PORT=5040
CIRCA_DB_PORT=5432
